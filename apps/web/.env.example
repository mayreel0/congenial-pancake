NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Optional VPN/LAN development: export DEV_VPN_HOST=<PC LAN or Tailscale IPv4>.
# DEV_VPN_ADDITIONAL_HOSTS accepts comma-separated additional PC IPv4 addresses.
# For file-based configuration, put these two hosts in .env.development.local only.
# Do not put VPN hosts in .env.local: it is also loaded by production builds.
# See docs/development-vpn.md. This overrides the API base with /api in next dev.
