NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/onseol
SESSION_COOKIE_NAME=session_token
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
ADMIN_USER_IDS=
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Email verification — tried in order, Resend first then Naver Cloud
# Mailer as fallback. Both optional; app boots without them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NAVER_CLOUD_MAILER_ACCESS_KEY=
NAVER_CLOUD_MAILER_SECRET_KEY=
NAVER_CLOUD_MAILER_FROM_EMAIL=
# Swagger/OpenAPI UI — served on its own port, separate from PORT.
SWAGGER_PORT=8081
