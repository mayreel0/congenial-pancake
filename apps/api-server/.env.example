NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/onseol
SESSION_COOKIE_NAME=session_token
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
ADMIN_USER_IDS=
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Swagger/OpenAPI UI mount path — has a default (api-reference-x7k2m9), only
# set this to override it with your own non-predictable value in production.
SWAGGER_DOCS_PATH=api-reference-x7k2m9
