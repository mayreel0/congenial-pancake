NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/onseol
SESSION_COOKIE_NAME=session_token
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:8081
ADMIN_USER_IDS=
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Swagger/OpenAPI UI — served on its own port, separate from PORT.
SWAGGER_PORT=8081
# Load-test-only throttle bypass (see load-test/README.md). Leave empty
# except when actually running load-test/scenarios/*.js locally — it's
# never honored when NODE_ENV=production regardless of this value, but
# still: never set a real value here or commit one anywhere.
LOAD_TEST_BYPASS_TOKEN=
