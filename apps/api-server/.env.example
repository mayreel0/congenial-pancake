NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/onseol
SESSION_COOKIE_NAME=session_token
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:8081
ADMIN_USER_IDS=
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Email verification — tried in order, Resend first then SES as an
# outage fallback. Both optional; app boots without them. SES uses the
# AWS SDK's default credential chain, not an env-var access key/secret —
# locally that means an ~/.aws profile or AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY, whichever you already have configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AWS_REGION=ap-northeast-2
SES_FROM_EMAIL=
# Reply moderation / local eval. Put the real API key in .env only.
# Production should receive secrets through infra/terraform SSM parameters.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=gpt-5-mini
# Swagger/OpenAPI UI — served on its own port, separate from PORT.
SWAGGER_PORT=8081
# Load-test-only throttle bypass (see tools/load-test/README.md). Leave
# empty except when actually running tools/load-test/scenarios/*.js
# locally — it's never honored when NODE_ENV=production regardless of
# this value, but still: never set a real value here or commit one
# anywhere.
LOAD_TEST_BYPASS_TOKEN=
