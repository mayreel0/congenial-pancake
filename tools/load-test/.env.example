# cp .env.example .env, then fill in real local values. .env is gitignored
# — never commit real values. See README.md "설정 한 번에 로드" for how
# both seed.ts and k6 pick these up from one file.

# Must match apps/api-server/.env's DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/onseol

# Must match apps/api-server's actual PORT (its .env.example default is
# 3001, but check your own apps/api-server/.env — it can differ locally).
BASE_URL=http://localhost:3001

# Only needed for scenarios/logged-in-read-write.js and
# scenarios/anonymous-read.js (the capacity scenarios). Must match
# apps/api-server/.env's LOAD_TEST_BYPASS_TOKEN exactly — leave both empty
# to skip those two scenarios, or if you're only running the correctness
# ones (ip-throttle / guest-reply-abuse / queue-concurrency), which don't
# use this at all.
LOAD_TEST_BYPASS_TOKEN=

# Only needed for scenarios/guest-reply-abuse.js. Matches the LOCAL DB's
# actual settings.guest_reply_limit (check with
# `SELECT guest_reply_limit FROM settings;` — it may not be the schema
# default of 5).
GUEST_REPLY_LIMIT=5
